    "README.md",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "lib",
    "test",
    "install.sh",
    "uninstall.sh",
    "install.ps1",
    "uninstall.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuyeQiuchen/dsh-fish-memory.git"
  },
